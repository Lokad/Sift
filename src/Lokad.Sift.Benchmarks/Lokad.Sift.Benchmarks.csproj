<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Lokad.Utf8Regex" />
    <Compile Include="..\..\examples\Utf8RegexAdapter.cs" Link="Adapters\Utf8RegexAdapter.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bench internal kernels in-assembly without granting friend access from
         the shipped Lokad.Sift assembly. -->
    <Compile Include="..\Lokad.Sift\**\*.cs"
             Exclude="..\Lokad.Sift\bin\**;..\Lokad.Sift\obj\**"
             LinkBase="Lokad.Sift.Source" />
  </ItemGroup>
</Project>

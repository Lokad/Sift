<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- See AGENTS.md. This symbol applies only to the source-linked verification
         copy; the product project rejects it during compilation and packing. -->
    <DefineConstants>$(DefineConstants);SIFT_INTERNAL_VERIFICATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Lokad.Utf8Regex" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\..\examples\Utf8RegexAdapter.cs" Link="Adapters\Utf8RegexAdapter.cs" />
    <EmbeddedResource Include="Fixtures\segment-v3.pack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lokad.Sift.Cli\Lokad.Sift.Cli.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep low-level verification in the implementation assembly without granting
         friend access from the shipped Lokad.Sift assembly. -->
    <Compile Include="..\..\src\Lokad.Sift\**\*.cs"
             Exclude="..\..\src\Lokad.Sift\bin\**;..\..\src\Lokad.Sift\obj\**"
             LinkBase="Lokad.Sift.Source" />
  </ItemGroup>
</Project>
